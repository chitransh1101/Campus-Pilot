# Copy this file to .env and fill in real values before running
# `docker compose up` for anything other than a quick throwaway local test.
# .env is gitignored — never commit real secrets.

# A long random string used to sign login sessions (JWTs). If left unset,
# a random one is generated every time the backend container starts, which
# means everyone gets signed out on every restart. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Only needed if the frontend and backend end up on two different public
# URLs (a real deployment) rather than both running on one machine via this
# same docker-compose.yml. Leave blank for local use.
API_BASE=
